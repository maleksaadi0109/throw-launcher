<ui:Page
    x:Class="Flow.Launcher.SettingPages.Views.SettingsPaneAbout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    Title="About Throw">
    <ui:ScrollViewerEx HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8 24 24 28">
            <TextBlock Foreground="#FD662B" FontSize="11" FontWeight="Bold" Text="BUILT TO GET YOU THERE" Margin="0 0 0 12" />
            <TextBlock Style="{StaticResource ThrowPageTitle}" Text="This is Throw." />
            <Border Margin="0 16 0 20" Padding="24" CornerRadius="18" Background="#122021">
                <StackPanel>
                    <Image Source="/Images/app.png" Width="64" Height="64" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Margin="0 16 0 8" Text="Throw Launcher" Foreground="#FFFFFF" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Find an app. Calculate something. Open a file. One place to start."
                               Foreground="#CEDDDB" TextWrapping="Wrap" />
                    <TextBlock Margin="0 16 0 0" Text="{Binding Version, StringFormat='Engine version: {0}'}"
                               Foreground="#FD996F" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ThrowSettingCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource ThrowSectionTitle}" Text="Your data stays yours" />
                    <TextBlock Style="{StaticResource ThrowDescription}"
                               Text="Settings are saved locally. Opening this folder does not reset or delete them." />
                    <Button Margin="0 16 0 0" HorizontalAlignment="Left" Content="Open settings folder"
                            Command="{Binding OpenParentOfSettingsFolderCommand}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ThrowSettingCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource ThrowSectionTitle}" Text="Open source, with credit" />
                    <TextBlock Style="{StaticResource ThrowDescription}"
                               Text="Throw Launcher is an independent fork built on Flow Launcher. The upstream MIT license and attribution are preserved. Not an official Flow Launcher release." />
                    <WrapPanel Margin="0 12 0 0">
                        <ui:HyperlinkButton Content="Throw source" NavigateUri="https://github.com/maleksaadi0109/throw-launcher" />
                        <ui:HyperlinkButton Content="Upstream credits" NavigateUri="https://github.com/Flow-Launcher/Flow.Launcher" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ui:ScrollViewerEx>
</ui:Page>

<ui:Page
    x:Class="Flow.Launcher.SettingPages.Views.SettingsPaneGeneral"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    Title="Essentials">
    <ui:ScrollViewerEx HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8 24 24 28">
            <TextBlock Foreground="#FD662B" FontSize="11" FontWeight="Bold" Text="MAKE IT YOURS" Margin="0 0 0 12" />
            <TextBlock Style="{StaticResource ThrowPageTitle}" Text="The essentials." />
            <TextBlock Style="{StaticResource ThrowDescription}" Margin="0 0 0 24"
                       Text="A few useful controls. Everything else stays out of your way." />

            <Border Style="{StaticResource ThrowSettingCard}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0 0 20 0">
                        <TextBlock Style="{StaticResource ThrowSectionTitle}" Text="Keep it light" />
                        <TextBlock Style="{StaticResource ThrowDescription}"
                                   Text="Use a smaller icon cache and fewer animations. Restart Throw after changing this." />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsOn="{Binding Settings.LiteMode}"
                                     OnContent="On" OffContent="Off" AutomationProperties.Name="Lite mode" />
                </Grid>
            </Border>
            <TextBlock Margin="4 0 0 14" TextWrapping="Wrap" Foreground="#FD662B"
                       Text="Restart Throw Launcher to apply your resource changes.">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Settings.ResourceRestartRequired}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Border Style="{StaticResource ThrowSettingCard}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0 0 20 0">
                        <TextBlock Style="{StaticResource ThrowSectionTitle}" Text="Ready when Windows starts" />
                        <TextBlock Style="{StaticResource ThrowDescription}" Text="Start Throw Launcher when you sign in." />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsOn="{Binding StartFlowLauncherOnSystemStartup}"
                                     OnContent="On" OffContent="Off" AutomationProperties.Name="Start Throw Launcher with Windows" />
                </Grid>
            </Border>
            <Border Style="{StaticResource ThrowSettingCard}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0 0 20 0">
                        <TextBlock Style="{StaticResource ThrowSectionTitle}" Text="Start quietly" />
                        <TextBlock Style="{StaticResource ThrowDescription}" Text="Keep the search window hidden until you need it." />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsOn="{Binding Settings.HideOnStartup}"
                                     OnContent="On" OffContent="Off" AutomationProperties.Name="Hide on startup" />
                </Grid>
            </Border>
            <Border Style="{StaticResource ThrowSettingCard}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0 0 20 0">
                        <TextBlock Style="{StaticResource ThrowSectionTitle}" Text="Get out of the way" />
                        <TextBlock Style="{StaticResource ThrowDescription}" Text="Hide search when you click another window." />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsOn="{Binding Settings.HideWhenDeactivated}"
                                     OnContent="On" OffContent="Off" AutomationProperties.Name="Hide when focus is lost" />
                </Grid>
            </Border>
            <Border Style="{StaticResource ThrowSettingCard}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0 0 20 0">
                        <TextBlock Style="{StaticResource ThrowSectionTitle}" Text="Your language" />
                        <TextBlock Style="{StaticResource ThrowDescription}" Text="Choose the language for supported interface text and search features." />
                    </StackPanel>
                    <ComboBox Grid.Column="1" MaxWidth="200" MinWidth="120" VerticalAlignment="Center"
                              ItemsSource="{Binding Languages}" DisplayMemberPath="Display" SelectedValuePath="LanguageCode"
                              SelectedValue="{Binding Language}" AutomationProperties.Name="Language" />
                </Grid>
            </Border>
            <Expander Header="Resource details" Margin="4 12 0 0">
                <StackPanel Margin="0 12 0 0">
                    <TextBlock Style="{StaticResource ThrowDescription}"
                               Text="Collected only when requested. No background monitoring. A snapshot is not a measured memory saving." />
                    <WrapPanel Margin="0 12 0 10">
                        <Button Margin="0 0 8 8" Content="Refresh snapshot" Command="{Binding RefreshPerformanceCommand}" />
                        <Button Margin="0 0 8 8" Content="Copy report" Command="{Binding CopyPerformanceReportCommand}" />
                        <Button Margin="0 0 0 8" Content="Export report" Command="{Binding ExportPerformanceReportCommand}" />
                    </WrapPanel>
                    <TextBox Text="{Binding PerformanceSummary, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                             AutomationProperties.Name="Resource snapshot" />
                    <TextBlock Style="{StaticResource ThrowDescription}" Text="{Binding ReportActionStatus}" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </ui:ScrollViewerEx>
</ui:Page>

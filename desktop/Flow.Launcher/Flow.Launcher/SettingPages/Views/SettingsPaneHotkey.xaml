<ui:Page
    x:Class="Flow.Launcher.SettingPages.Views.SettingsPaneHotkey"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:flowlauncher="clr-namespace:Flow.Launcher"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    Title="Controls">
    <ui:ScrollViewerEx HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8 24 24 28">
            <TextBlock Foreground="#FD662B" FontSize="11" FontWeight="Bold" Text="THROW / CONTROLS" Margin="0 0 0 12" />
            <TextBlock Style="{StaticResource ThrowPageTitle}" Text="One shortcut. Your workspace." />
            <TextBlock Style="{StaticResource ThrowDescription}" Margin="0 0 0 24"
                       Text="Fresh profiles use Ctrl + Alt + Space so Throw does not take over Flow's default shortcut. You can choose another key below." />
            <Border Style="{StaticResource ThrowSettingCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource ThrowSectionTitle}" Text="Open Throw Launcher" />
                    <TextBlock Style="{StaticResource ThrowDescription}" Text="Your system-wide shortcut. Select below to change it." />
                    <flowlauncher:HotkeyControl Margin="0 16 0 0" HorizontalAlignment="Left"
                        ChangeHotkey="{Binding SetTogglingHotkeyCommand}" DefaultHotkey="Alt+Space"
                        Type="Hotkey" ValidateKeyGesture="True" WindowTitle="Open Throw Launcher" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ThrowSettingCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource ThrowSectionTitle}" Text="Preview the selected result" />
                    <flowlauncher:HotkeyControl Margin="0 16 0 0" HorizontalAlignment="Left"
                        DefaultHotkey="F1" Type="PreviewHotkey" ValidateKeyGesture="False" WindowTitle="Preview result" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ThrowSettingCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource ThrowSectionTitle}" Text="The everyday keys" />
                    <TextBlock Style="{StaticResource ThrowDescription}"
                               Text="↑ / ↓   Select a result&#x0a;Enter   Open the selection&#x0a;Esc   Back or close search" />
                    <TextBlock Style="{StaticResource ThrowDescription}"
                               Text="{Binding Settings.SettingWindowHotkey, StringFormat='Settings shortcut: {0}'}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ui:ScrollViewerEx>
</ui:Page>

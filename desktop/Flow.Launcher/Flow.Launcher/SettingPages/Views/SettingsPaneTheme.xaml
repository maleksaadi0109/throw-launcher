<ui:Page
    x:Class="Flow.Launcher.SettingPages.Views.SettingsPaneTheme"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    Title="Appearance">
    <ui:ScrollViewerEx HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8 24 24 28">
            <TextBlock Foreground="#FD662B" FontSize="11" FontWeight="Bold" Text="THROW / APPEARANCE" Margin="0 0 0 12" />
            <TextBlock Style="{StaticResource ThrowPageTitle}" Text="Make room for focus." />
            <TextBlock Style="{StaticResource ThrowDescription}" Margin="0 0 0 24"
                       Text="Choose your search surface. The Throw theme is the default; other installed themes remain available." />
            <Border Background="#122021" CornerRadius="20" Padding="24" Margin="0 0 0 20">
                <StackPanel>
                    <TextBlock Foreground="#FD996F" FontSize="11" FontWeight="Bold" Text="SIGNATURE / THROW" />
                    <TextBlock Foreground="White" FontSize="27" Margin="0 14 0 8" Text="Find your next thing." />
                    <TextBlock Foreground="#CEDDDB" TextWrapping="Wrap"
                               Text="Deep ink. Warm orange. Quiet surfaces. No backdrop effects required." />
                    <Border Margin="0 20 0 0" Background="#203331" CornerRadius="12" Padding="16">
                        <TextBlock Foreground="White" Text="Search apps, files, calculations…" />
                    </Border>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ThrowSettingCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource ThrowSectionTitle}" Text="Search theme" />
                    <ComboBox Margin="0 14 0 0" ItemsSource="{Binding Themes}"
                              SelectedItem="{Binding SelectedTheme}" DisplayMemberPath="Name"
                              AutomationProperties.Name="Search theme" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ThrowSettingCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource ThrowSectionTitle}" Text="Type that reads comfortably" />
                    <TextBlock Margin="0 14 0 6" Text="Search text size" />
                    <Slider Minimum="14" Maximum="36" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding QueryBoxFontSize}" AutomationProperties.Name="Search text size" />
                    <TextBlock Margin="0 16 0 6" Text="Result title size" />
                    <Slider Minimum="12" Maximum="26" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding ResultItemFontSize}" AutomationProperties.Name="Result title size" />
                    <TextBlock Margin="0 16 0 6" Text="Result detail size" />
                    <Slider Minimum="10" Maximum="22" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding ResultSubItemFontSize}" AutomationProperties.Name="Result detail size" />
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource ThrowDescription}"
                       Text="Lite mode limits animations independently of the theme. Changing appearance does not turn Lite mode off." />
        </StackPanel>
    </ui:ScrollViewerEx>
</ui:Page>

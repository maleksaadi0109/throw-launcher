<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib">
    <!--
    Name: Throw
    IsDark: True
    HasBlur: False
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Themes/Midnight.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <CornerRadius x:Key="ItemRadius">10</CornerRadius>
    <Thickness x:Key="ItemMargin">8 3</Thickness>
    <system:Double x:Key="ResultItemHeight">60</system:Double>

    <Style x:Key="WindowBorderStyle" BasedOn="{StaticResource BaseWindowBorderStyle}" TargetType="Border">
        <Setter Property="Background" Value="#122021" />
        <Setter Property="BorderBrush" Value="#35514E" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="18" />
    </Style>
    <Style x:Key="QueryBoxStyle" BasedOn="{StaticResource BaseQueryBoxStyle}" TargetType="TextBox">
        <Setter Property="Foreground" Value="#F4F8F6" />
        <Setter Property="CaretBrush" Value="#FD662B" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Margin" Value="20 12 0 12" />
    </Style>
    <Style x:Key="QuerySuggestionBoxStyle" BasedOn="{StaticResource BaseQuerySuggestionBoxStyle}" TargetType="TextBox">
        <Setter Property="Foreground" Value="#78918D" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Margin" Value="20 12 0 12" />
    </Style>
    <Style x:Key="ItemTitleStyle" BasedOn="{StaticResource BaseItemTitleStyle}" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#F4F8F6" />
    </Style>
    <Style x:Key="ItemTitleSelectedStyle" BasedOn="{StaticResource BaseItemTitleSelectedStyle}" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style x:Key="ItemSubTitleStyle" BasedOn="{StaticResource BaseItemSubTitleStyle}" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#AAC0BC" />
    </Style>
    <Style x:Key="ItemSubTitleSelectedStyle" BasedOn="{StaticResource BaseItemSubTitleSelectedStyle}" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#FFD3BF" />
    </Style>
    <SolidColorBrush x:Key="ItemSelectedBackgroundColor">#29443F</SolidColorBrush>
    <Style x:Key="SearchIconStyle" BasedOn="{StaticResource BaseSearchIconStyle}" TargetType="Path">
        <Setter Property="Fill" Value="#FD996F" />
    </Style>
</ResourceDictionary>
